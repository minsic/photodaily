APP_NAME=PhotoDaily
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@photodaily.test"
MAIL_FROM_NAME="${APP_NAME}"

# Immagini su Cloudflare R2 (bucket privato, API S3-compatibile)
PHOTOS_DISK=r2
PHOTOS_URL_TTL_MINUTES=60
PHOTOS_MAX_UPLOAD_KB=20480
THUMBNAIL_MEMORY_LIMIT=512M
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto

# Indirizzo principale del servizio: le famiglie sono <slug>.<host> (in produzione https://photodaily.app)
FRONTEND_URL=http://localhost:5173
# Proxy da cui accettare X-Forwarded-Host: 127.0.0.1 in sviluppo (proxy di Vite), vuoto in produzione
TRUSTED_PROXIES=127.0.0.1
# Origini CORS: servono solo se il frontend non è sullo stesso host dell'API
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://giopellino.it
INVITE_TTL_DAYS=7
# Durata del token di sola lettura per le famiglie in modalità "password"
PUBLIC_TOKEN_TTL_DAYS=7
DEFAULT_PLAN=beta

VITE_APP_NAME="${APP_NAME}"

# Promemoria serale (Web Push). Le chiavi si generano con `php artisan webpush:vapid`.
VAPID_SUBJECT=mailto:noreply@photodaily.app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
