# .env di produzione del backend. provision.sh lo copia in
# /var/www/photodaily/shared/.env generando APP_KEY e DB_PASSWORD;
# il resto (R2, mail) va completato a mano sul server.

APP_NAME=PhotoDaily
APP_ENV=production
# Non cambiarla mai: invaliderebbe i token di sola lettura già emessi.
APP_KEY=
APP_DEBUG=false
APP_URL=https://photodaily.app

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=photodaily
DB_USERNAME=photodaily
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail degli inviti via Brevo (SMTP e API > SMTP). Il dominio photodaily.app
# è autenticato su Brevo (record brevo-code, DKIM brevo1/brevo2, DMARC).
# Finché MAIL_PASSWORD è vuota lasciare MAIL_MAILER=log: con smtp senza
# credenziali la creazione di un invito va in errore.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@photodaily.app"
MAIL_FROM_NAME="${APP_NAME}"

# Immagini su Cloudflare R2: bucket di produzione, separato da photodaily-dev.
PHOTOS_DISK=r2
PHOTOS_URL_TTL_MINUTES=60
PHOTOS_MAX_UPLOAD_KB=25600
THUMBNAIL_MEMORY_LIMIT=512M
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto

# Indirizzo principale: le famiglie sono <slug>.photodaily.app.
FRONTEND_URL=https://photodaily.app
# Caddy parla con PHP-FPM direttamente: nessun proxy di cui fidarsi.
TRUSTED_PROXIES=
# Frontend e API sullo stesso host: CORS non serve.
CORS_ALLOWED_ORIGINS=

INVITE_TTL_DAYS=7
PUBLIC_TOKEN_TTL_DAYS=7
DEFAULT_PLAN=beta

# Promemoria serale (Web Push). Le chiavi si generano con `php artisan webpush:vapid`.
VAPID_SUBJECT=mailto:noreply@photodaily.app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
